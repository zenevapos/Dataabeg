rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Allow users to read/write their own profile, or unauthenticated read
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection: Allow creating and reading orders for guests and logged in users
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null && 
        (request.auth.token.email.matches('(?i)^kokoroowoabdulsalam@gmail\\.com$') || resource.data.userId == request.auth.uid);
    }

    // Settings collection: Anyone can read settings, only admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.matches('(?i)^kokoroowoabdulsalam@gmail\\.com$');
    }

    // Phone verifications: Allows creating challenges and reading verification status during WhatsApp sign-up
    match /phone_verifications/{phone} {
      allow read, write: if true;
    }
  }
}
