rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Allow users to read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection: Allow logged in users to create and read orders
    match /orders/{orderId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (request.auth.token.email == 'Kokoroowoabdulsalam@gmail.com' || resource.data.userId == request.auth.uid);
    }

    // Settings collection: Anyone can read settings, only admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'Kokoroowoabdulsalam@gmail.com';
    }
  }
}
